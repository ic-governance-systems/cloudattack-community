{
  "format_version": "1.2",
  "terraform_version": "1.8.0",
  "resource_changes": [
    {
      "address": "aws_iam_role.developer",
      "type": "aws_iam_role",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "developer-role",
          "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"lambda.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}"
        },
        "after_unknown": {}
      }
    },
    {
      "address": "aws_iam_role_policy.passrole",
      "type": "aws_iam_role_policy",
      "change": {
        "actions": ["create"],
        "after": {
          "role": "developer-role",
          "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"iam:PassRole\",\"Resource\":\"arn:aws:iam::000000000000:role/demo-admin-role\"}]}"
        },
        "after_unknown": {}
      }
    }
  ]
}
